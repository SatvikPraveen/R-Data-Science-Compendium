linters: linters_with_defaults(
    line_length_linter(100),
    # R (replicates) and L (influence values) follow the notation of the
    # bootstrap literature and of the boot package.
    object_name_linter(
      styles = c("snake_case", "symbols"),
      regexes = c(notation = "^(R|L)$", rng = "^\\.Random\\.seed$")
    ),
    indentation_linter = NULL
  )
exclusions: list(
    "modules",
    "shiny-apps",
    "analysis",
    "vignettes",
    "man",
    "docs"
  )
encoding: "UTF-8"
