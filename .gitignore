# R session artefacts
.Rhistory
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
*.Rproj

# Package build / check output
*.tar.gz
*.Rcheck/
src/*.o
src/*.so
src/*.dll

# Rendered documentation (built by CI / pkgdown, never committed)
docs/
inst/doc/
vignettes/*.html
vignettes/*.pdf
vignettes/*_files/
vignettes/*_cache/
*.knit.md
*.utf8.md

# Analysis: raw inputs and caches are not tracked; derived results are
analysis/**/*_cache/
analysis/**/*_files/
analysis/paper/*.html
analysis/paper/*.pdf
analysis/paper/*.tex
analysis/paper/*.log
data/raw/
data/temp/
data/processed/*
!data/processed/.gitkeep

# Case-study and Shiny outputs
modules/case-studies/*.html
modules/case-studies/*_files/
rsconnect/

# renv library (the lockfile is tracked)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# Coverage reports
coverage.html
lib/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Secrets
.Renviron
.env
*.pem
*.key

# Local Claude Code settings
.claude/settings.local.json
